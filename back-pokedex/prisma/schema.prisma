generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pokemon {
  id              Int         @id //@default(autoincrement())
  nombre          String      @db.VarChar(250)
  descripcion     String      @db.Text
  types           String      @db.Text
  grunido         String      @db.VarChar(500)
  imagen          String      @db.VarChar(500)
  vida            Int?
  ataque          Int?
  defensa         Int?
  ataqueEspecial  Int?        @map("ataque_especial")
  defensaEspecial Int?        @map("defensa_especial")
  velocidad       Int?
  tipoPokemon     tipoPokemon[] 
  usuarioFavorito Usuario[] @relation("favoritos")
  equipos         EquipoPokemon[]

  @@map("pokemon") // Nombre de la tabla en la base de datos
}

model tipoPokemon {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(255)
  pokemons Pokemon[] 

  @@map("tipo_pokemon") // Nombre de la tabla en la base de datos
}

model Usuario {
  id         Int      @id @default(autoincrement())
  username   String   @unique @db.VarChar(100)
  contrasena String   @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  favoritos  Pokemon[] @relation("favoritos")
  equipo     EquipoPokemon[]

  @@map("usuario") // Nombre de la tabla en la base de datos
}

model EquipoPokemon {
  id        Int      @id @default(autoincrement())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId Int      @map("usuario_id")
  pokemon   Pokemon  @relation(fields: [pokemonId], references: [id])
  pokemonId Int      @map("pokemon_id")
  posicion  Int      // Posición en el equipo (1-6)
  esLider   Boolean  @default(false) @map("es_lider") // Si es el Pokémon líder del equipo
  createdAt DateTime @default(now()) @map("created_at")
  @@map("equipo_pokemon")
}

